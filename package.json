{
  "name": "armenian-transliteration",
  "version": "3.0.0",
  "description": "Multi-standard Armenian transliteration (BGN/PCGN, ISO 9985, Hübschmann-Meillet, ALA-LC, Russian geographic profiles, Russian proper names, IPA)",
  "keywords": [
    "armenian",
    "transliteration",
    "romanization",
    "bgn-pcgn",
    "iso-9985",
    "hubschmann-meillet",
    "ala-lc",
    "cyrillic",
    "russian",
    "ru-geo-kt-1974",
    "ru-geo-ra-2011",
    "ru-proper-vartapetyan-1961",
    "ru-phonetic-eastern",
    "ipa",
    "phonemic",
    "unicode"
  ],
  "bugs": {
    "url": "https://github.com/lobotomoe/armenian-transliteration/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobotomoe/armenian-transliteration.git"
  },
  "homepage": "https://github.com/lobotomoe/armenian-transliteration#readme",
  "license": "ISC",
  "author": "Alex Kraiz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "import": "./lib/index.js"
    },
    "./profiles": {
      "types": "./lib/profiles/index.d.ts",
      "require": "./lib/profiles/index.cjs",
      "import": "./lib/profiles/index.js"
    },
    "./profiles/*": "./profiles/*",
    "./browser": "./lib/index.global.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*",
    "profiles/**/*",
    "README.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "clean": "rimraf lib dist",
    "build": "rimraf lib dist && tsup",
    "watch": "rimraf lib dist && tsup --watch src",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepublishOnly": "npm run build",
    "test": "jest --env=node --colors --coverage test --verbose --silent=false"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "jest": "^30.4.2",
    "knip": "^6.12.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <=2.0.1": "^2.0.2",
      "brace-expansion@>=1.0.0 <1.1.12": "^1.1.12",
      "minimatch@<9.0.7": "^9.0.7",
      "glob@<10.5.0": "^10.5.0",
      "picomatch@<2.3.2": "^2.3.2"
    }
  }
}
